---
import "../styles/style.css";

const philosophyItems = [
  { no: "01", en: "Put People Where They Shine", ja: "人が最も輝く場所を見つける" },
  { no: "02", en: "Grow People, Not Just Performance", ja: "成果より先に、人の成長を" },
  { no: "03", en: "Different People, One Purpose", ja: "違いを、力に変える" },
  { no: "04", en: "People First, Value Follows", ja: "人を大切にすることから価値は生まれる" },
  { no: "05", en: "Change the Perspective", ja: "答えを変える前に、視点を変える" },
  { no: "06", en: "Build the Environment, Unlock the Potential", ja: "人ではなく、環境を変える" },
  { no: "07", en: "Orchestrate, Don't Control", ja: "管理ではなく、設計する" },
  { no: "08", en: "Continuity Creates Strength", ja: "継続は、未来を変える力になる" },
  { no: "09", en: "Change Yourself", ja: "自分の意思で、変わる" },
];
---

<div class="scroll-container">
  <section class="hero-section" id="home">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="hero-text-wrapper" aria-label="Change yourself mantra">
        <div class="hero-panel-grid">
          <div
            class="hero-panel hero-panel--left slide-left"
            style="--panel-delay: 0s;"
          >
            <p class="hero-panel-text">環境が変われば行動が変わる。</p>
          </div>
          <div
            class="hero-panel hero-panel--right slide-right"
            style="--panel-delay: 0.15s;"
          >
            <p class="hero-panel-text">行動が変われば習慣が変わる。</p>
          </div>
          <div
            class="hero-panel hero-panel--left slide-left"
            style="--panel-delay: 0.3s;"
          >
            <p class="hero-panel-text">習慣が変われば人格が変わる。</p>
          </div>
          <div
            class="hero-panel hero-panel--right slide-right"
            style="--panel-delay: 0.45s;"
          >
            <p class="hero-panel-text">人格が変われば運命が変わる。</p>
          </div>
          <div
            class="hero-panel hero-panel--full slide-bottom"
            style="--panel-delay: 0.75s;"
          >
            <h1 class="hero-headline hero-main-title">Change yourself.</h1>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="philosophy-section" id="philosophy">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="philosophy-header">
        <h2 class="philosophy-title">Our Philosophy</h2>
        <p class="philosophy-subtitle">
          人を、最も輝く場所へ。私たちが大切にしている9つの考え方。
        </p>
      </div>
      <ul class="philosophy-grid">
        {
          philosophyItems.map((item) => (
            <li class="philosophy-card">
              <span class="philosophy-no">{item.no}</span>
              <h3 class="philosophy-name">{item.en}</h3>
              <p class="philosophy-lead">{item.ja}</p>
            </li>
          ))
        }
      </ul>
      <div class="philosophy-actions">
        <a href="/philosophy" class="cta-button primary">理念をすべて読む</a>
      </div>
    </div>
  </section>

  <section class="apps-section" id="apps">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="apps-header">
        <h2 class="apps-title">Apps</h2>
        <p class="apps-subtitle">Explore our ecosystem of applications</p>
      </div>
      <div class="apps-grid">
        <!-- Riddle -->
        <a href="/riddle" class="app-card" data-theme="riddle">
          <div class="app-icon-wrapper">
            <img src="/RiddleLogo.png" alt="Riddle" class="app-icon-img" />
          </div>
          <div class="app-info">
            <h3 class="app-name">Riddle</h3>
            <span class="app-tag">クイズ✖️SNS</span>
          </div>
        </a>

        <!-- Prompty -->
        <a href="/prompty" class="app-card" data-theme="prompty">
          <div class="app-icon-wrapper">
            <img
              src="/Prompty/icon_removebg-preview.png"
              alt="Prompty"
              class="app-icon-img"
            />
          </div>
          <div class="app-info">
            <h3 class="app-name">Prompty</h3>
            <span class="app-tag">Promptを生成・共有</span>
          </div>
        </a>

        <!-- PlayHub -->
        <a href="/playhub" class="app-card" data-theme="playhub">
          <div class="app-icon-wrapper">
            <img
              src="/playhub_icon-removebg-preview.png"
              alt="PlayHub"
              class="app-icon-img"
            />
          </div>
          <div class="app-info">
            <h3 class="app-name">PlayHub</h3>
            <span class="app-tag">AI × ゲームコミュニティ</span>
          </div>
        </a>

        <!-- Summaries -->
        <a
          href="/summaries_app_description"
          class="app-card"
          data-theme="summaries"
        >
          <div class="app-icon-wrapper">
            <img
              src="/SummariesLogo.png"
              alt="Summaries"
              class="app-icon-img"
            />
          </div>
          <div class="app-info">
            <h3 class="app-name">Summaries</h3>
            <span class="app-tag">要約✖️SNS</span>
          </div>
        </a>

        <!-- Orchestra -->
        <a
          href="https://division.he-ro.jp/"
          class="app-card"
          data-theme="orchestra"
        >
          <div class="app-icon-wrapper">
            <img
              src="/OrchestralLogo.png"
              alt="Orchestra"
              class="app-icon-img"
            />
          </div>
          <div class="app-info">
            <h3 class="app-name">Orchestra</h3>
            <span class="app-tag">ID E</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="contact-card">
        <h2 class="contact-title">お問い合わせ</h2>
        <p class="contact-description">
          ご質問や導入のご相談がありましたら、お気軽にお知らせください。専門チームが迅速にサポートいたします。
        </p>
        <div class="contact-actions">
          <a
            href="/contact"
            class="cta-button primary"
            aria-label="お問い合わせフォームへ"
          >
            <span class="cta-icon">💬</span>お問い合わせフォーム
          </a>
          <a
            href="mailto:higuchiyuya.riddle@gmail.com"
            class="cta-button secondary"
            aria-label="メールで問い合わせる"
          >
            <span class="cta-icon">✉️</span>メールで相談する
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* Global Reset & Base */
  * {
    box-sizing: border-box;
  }

  .scroll-container {
    background-color: var(--bg-body);
    color: var(--text-main);
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
    overflow-x: hidden;
    scroll-behavior: smooth;
    transition:
      background-color 0.5s ease,
      color 0.5s ease;
  }

  /* Section Layout */
  .scroll-container > section {
    min-height: 100vh;
    padding: 4rem 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .section-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  /* Hero Section */
  .hero-section {
    background: var(--bg-body);
  }

  .hero-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(var(--hero-grid-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--hero-grid-color) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: 1;
    pointer-events: none;
  }

  .hero-text-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
  }

  .hero-panel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    width: 100%;
    max-width: 900px;
  }

  .hero-panel {
    background: var(--panel-bg);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(10px);
    padding: 2.5rem;
    border-radius: 24px;
    transition: var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0; /* Animated in */
    animation-fill-mode: forwards;
    animation-duration: 0.8s;
  }

  .hero-panel:hover {
    transform: translateY(-5px);
    background: var(--card-hover-bg);
    border-color: var(--text-main);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  :global([data-theme="dark"]) .hero-panel:hover {
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
  }

  .hero-panel--full {
    grid-column: span 2;
    background: transparent;
    border: none;
    padding: 4rem 0;
  }

  .hero-panel-text {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.6;
    margin: 0;
    color: var(--text-main);
  }

  .hero-main-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 1.2;
    background: var(--title-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.1);
    margin: 0;
    padding-bottom: 0.1em;
  }

  :global([data-theme="dark"]) .hero-main-title {
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.3);
  }

  /* Animations */
  .slide-left {
    animation-name: slideInLeft;
  }
  .slide-right {
    animation-name: slideInRight;
  }
  .slide-bottom {
    animation-name: slideInUp;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Philosophy Section */
  .philosophy-section {
    background: var(--bg-body);
    border-top: 1px solid var(--border-color);
  }

  .philosophy-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .philosophy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
    background: var(--title-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-bottom: 0.05em;
  }

  .philosophy-subtitle {
    font-size: 1.1rem;
    line-height: 1.9;
    color: var(--text-muted);
    margin: 0;
  }

  .philosophy-grid {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .philosophy-card {
    background: var(--panel-bg);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .philosophy-card:hover {
    transform: translateY(-6px);
    background: var(--card-hover-bg);
    border-color: var(--text-main);
    box-shadow: 0 18px 36px -18px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme="dark"]) .philosophy-card:hover {
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
  }

  .philosophy-no {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--text-muted);
  }

  .philosophy-name {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0;
    color: var(--text-main);
  }

  .philosophy-lead {
    font-size: 0.95rem;
    line-height: 1.8;
    margin: auto 0 0;
    color: var(--text-muted);
  }

  .philosophy-actions {
    display: flex;
    justify-content: center;
  }

  /* Apps Section */
  .apps-section {
    background: var(--bg-body);
    border-top: 1px solid var(--border-color);
  }

  .apps-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .apps-title {
    font-size: 3rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    background: var(--title-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .apps-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin: 0;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding: 0 1rem;
  }

  .app-card {
    background: var(--panel-bg);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .app-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      var(--accent-glow, rgba(255, 255, 255, 0.1)) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .app-card:hover {
    transform: translateY(-8px);
    background: var(--card-hover-bg);
    border-color: var(--accent);
    box-shadow: 0 20px 40px -10px var(--accent-glow, rgba(0, 0, 0, 0.3));
  }

  :global([data-theme="dark"]) .app-card:hover {
    box-shadow: 0 20px 40px -10px var(--accent-glow, rgba(0, 0, 0, 0.5));
  }

  .app-card:hover::before {
    opacity: 0.2;
  }

  .app-icon-wrapper {
    width: 100px;
    height: 100px;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.4s ease;
  }

  :global([data-theme="dark"]) .app-icon-wrapper {
    background: rgba(0, 0, 0, 0.2);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  .app-card:hover .app-icon-wrapper {
    transform: scale(1.1) rotate(3deg);
  }

  .app-icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22px;
  }

  .app-icon-emoji {
    font-size: 3.5rem;
    line-height: 1;
  }

  .app-info {
    position: relative;
    z-index: 1;
  }

  .app-name {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--text-main);
  }

  .app-tag {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
  }

  :global([data-theme="dark"]) .app-tag {
    background: rgba(255, 255, 255, 0.05);
  }

  .app-card:hover .app-tag {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    font-weight: 700;
  }

  :global([data-theme="light"]) .app-card:hover .app-tag {
    color: #000;
  }

  /* App specific accents */
  :global([data-theme="riddle"]) {
    --accent: var(--color-riddle);
    --accent-glow: var(--color-riddle-glow);
  }
  :global([data-theme="prompty"]) {
    --accent: var(--color-prompty);
    --accent-glow: var(--color-prompty-glow);
  }
  :global([data-theme="playhub"]) {
    --accent: var(--color-playhub);
    --accent-glow: var(--color-playhub-glow);
  }
  :global([data-theme="summaries"]) {
    --accent: var(--color-summaries);
    --accent-glow: var(--color-summaries-glow);
  }
  :global([data-theme="orchestra"]) {
    --accent: var(--color-orchestra);
    --accent-glow: var(--color-orchestra-glow);
  }

  /* Contact Section */
  .contact-section {
    background: var(--contact-bg);
    color: var(--text-main);
    border-top: 1px solid var(--border-color);
  }

  .contact-card {
    background: var(--bg-card);
    border-radius: 34px;
    padding: 3.5rem 2.6rem;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(22px);
    max-width: 760px;
    margin: 0 auto;
    border: 1px solid var(--border-color);
    text-align: center;
  }

  :global([data-theme="dark"]) .contact-card {
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.4);
  }

  .contact-title {
    font-size: clamp(2.1rem, 4vw, 2.9rem);
    font-weight: 800;
    margin: 0 0 1rem;
  }

  .contact-description {
    font-size: 1.05rem;
    line-height: 1.9;
    margin: 0 auto 2rem;
    max-width: 520px;
    color: var(--text-muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.9rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    border: none;
  }

  .cta-button.primary {
    background: var(--text-main);
    color: var(--bg-body);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.1);
  }

  .cta-button.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2);
  }

  .cta-button.secondary {
    background: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-color);
  }

  .cta-button.secondary:hover {
    background: var(--card-hover-bg);
    transform: translateY(-2px);
    border-color: var(--text-main);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .philosophy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .scroll-container > section {
      padding-top: 150px;
    }
    .hero-panel-grid {
      grid-template-columns: 1fr;
    }
    .hero-panel--full {
      grid-column: span 1;
    }
    .philosophy-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .philosophy-card {
      padding: 1.5rem 1.25rem;
    }
    .apps-grid {
      grid-template-columns: 1fr;
      padding: 0;
    }
    .app-card {
      flex-direction: row;
      text-align: left;
      align-items: center;
      padding: 1.5rem;
      gap: 1.5rem;
    }
    .app-icon-wrapper {
      width: 70px;
      height: 70px;
      margin-bottom: 0;
      flex-shrink: 0;
    }
    .app-icon-emoji {
      font-size: 2.5rem;
    }
    .app-name {
      font-size: 1.4rem;
      margin-bottom: 0.2rem;
    }
  }
</style>
