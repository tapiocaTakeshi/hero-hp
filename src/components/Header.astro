---
import "../styles/style.css";
import ThemeIcon from "./ThemeIcon.astro";
const { pathname } = Astro.url;
---

<header id="main-header" class="header">
  <div class="header-content">
    <div class="logo">
      <a href="/" aria-label="Hero HP ホームページ">
        <img class="icon icon-light" src="/He-ro_icon.png" alt="Hero Logo" />
        <img
          class="icon icon-dark"
          src="/He-ro_icon_white.png"
          alt="Hero Logo"
        />
      </a>
    </div>

    <nav class="main-nav" id="main-nav">
      <ul class="nav-list">
        <li>
          <a
            href="/"
            class:list={["nav-link", { active: pathname === "/" }]}
            data-page="home">Home</a
          >
        </li>
        <li><a href="/#apps" class="nav-link" data-page="apps">Apps</a></li>
        <li>
          <a
            href="/contact"
            class:list={["nav-link", { active: pathname === "/contact" }]}
            data-page="contact">Contact</a
          >
        </li>
        <li>
          <ThemeIcon />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("main-header");

  const applyHeaderState = () => {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  };

  const setActiveNav = (page: string | null) => {
    document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
      const linkPage = link.getAttribute("data-page");
      if (page && linkPage === page) {
        link.classList.add("active");
      } else {
        link.classList.remove("active");
      }
    });
  };

  const updateActiveNavOnScroll = () => {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("section[id]")
    ).filter((s) => ["home", "apps", "contact"].includes(s.id));

    if (sections.length === 0) return;

    const triggerLine = window.innerHeight * 0.35;
    let current: string | null = null;

    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      if (rect.top <= triggerLine && rect.bottom > triggerLine) {
        current = section.id;
        break;
      }
    }

    if (!current) {
      if (window.scrollY < 50) {
        current = sections[0].id;
      } else if (
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2
      ) {
        current = sections[sections.length - 1].id;
      }
    }

    if (current) setActiveNav(current);
  };

  const initActiveNav = () => {
    const currentPath = window.location.pathname;
    if (currentPath === "/") {
      updateActiveNavOnScroll();
    } else {
      const match = document.querySelector<HTMLAnchorElement>(
        `.nav-link[href="${currentPath}"]`
      );
      setActiveNav(match?.getAttribute("data-page") ?? null);
    }
  };

  let scrollTicking = false;
  const onScroll = () => {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      applyHeaderState();
      if (window.location.pathname === "/") {
        updateActiveNavOnScroll();
      }
      scrollTicking = false;
    });
  };

  const setup = () => {
    applyHeaderState();
    initActiveNav();
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  document.addEventListener("DOMContentLoaded", setup);
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .header {
    --header-inline-padding: var(--layout-padding-inline, 2.5rem);
    --header-inline-start: max(
      var(--header-inline-padding),
      env(safe-area-inset-left, 0px)
    );
    --header-inline-end: max(
      var(--header-inline-padding),
      env(safe-area-inset-right, 0px)
    );
    padding-top: clamp(0.85rem, 4vw, 1.6rem);
    padding-bottom: clamp(0.65rem, 3vw, 1.1rem);
    padding-left: var(--header-inline-start);
    padding-right: var(--header-inline-end);
    width: 100%;
    box-sizing: border-box;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Scrolled State */
  .header.scrolled {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    background-color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  :global([data-theme="dark"]) .header.scrolled {
    background-color: rgba(10, 10, 10, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo a {
    display: flex;
    align-items: center;
  }

  .icon {
    width: 42px;
    height: auto;
    transition: transform 0.3s ease;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35));
    display: none; /* Hidden by default, shown based on theme */
  }

  .icon-light {
    display: block;
  }

  :global([data-theme="dark"]) .icon-light {
    display: none;
  }

  :global([data-theme="dark"]) .icon-dark {
    display: block;
  }

  .logo:hover .icon {
    transform: scale(1.05);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--nav-link-color, #1e293b);
    text-decoration: none;
    font-weight: 500;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    letter-spacing: 0.02em;
  }

  :global([data-theme="dark"]) .nav-link {
    --nav-link-color: #f5f5f5;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .header.scrolled .nav-link {
    color: var(--nav-link-scrolled, #111111);
  }

  :global([data-theme="dark"]) .header.scrolled .nav-link {
    --nav-link-scrolled: #ffffff;
  }

  @media (max-width: 768px) {
    .header {
      --header-inline-padding: var(--layout-padding-inline, 1.25rem);
      padding-top: clamp(0.75rem, 3vw, 1.2rem);
      padding-bottom: clamp(0.55rem, 3vw, 0.9rem);
    }
    .header-content {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-list {
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .nav-link {
      font-size: 0.9rem;
    }
  }
</style>
