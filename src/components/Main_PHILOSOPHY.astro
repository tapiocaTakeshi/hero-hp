---
import "../styles/style.css";

const visionStanzas = [
  "he-roが目指すのは、\n一人ひとりが自分らしく輝きながら、仲間とともに成長できる組織。",
  "誰か一人がすべてをできる必要はない。",
  "人にはそれぞれ、強みがあり、弱みがある。\nだからこそ、お互いの強みを活かし、弱みを補い合う。",
  "誰が一番優秀かではなく、誰をどこに置けば一番輝けるのか。",
  "人を競わせて順位をつけるのではなく、\n一人ひとりが自分の能力を最大限発揮できる場所をつくる。",
  "そして、仲間だからこそ遠慮するのではなく、\n時には意見がぶつかり合っても、お互いをリスペクトしながら、切磋琢磨する。",
  "相手の成功を喜び、相手の成長から学び、\n自分ももっと成長しようと思える関係をつくる。",
  "困っている仲間がいれば支え、\n自分にできないことがあれば仲間を頼る。",
  "「助けてもらうこと」も「助けること」も、チームの強さである。",
  "he-roは、最初から完璧な人を求めない。",
  "「即戦力かどうか」で人の可能性を決めるのではなく、\nその人がこれからどれだけ成長できるのかを大切にする。",
  "人を見抜くことより、\n人を育てられる組織であること。",
  "教えるときに威圧しない。\n失敗した人を責めるのではなく、なぜそうなったのかを一緒に考える。",
  "すぐに答えを出すことよりも、\n時間がかかっても理解に徹する。",
  "分からないことを恥ずかしいことにしない。\n質問できること、挑戦できること、失敗できることを強さにする。",
  "そして、一度の成功よりも継続を大切にする。",
  "継続は力なり。",
  "小さな努力でも積み重ねれば、大きな力になる。\n昨日の自分より今日の自分、今日の自分より明日の自分へ。",
  "仲間同士で支え合い、刺激し合い、成長し続ける。",
  "会社が人を輝かせ、\n輝いた人が会社を強くする。",
  "会社のために人がいるのではなく、\n人が輝くために会社がある。",
  "一人ではできないことを、チームならできる。",
  "強みを掛け合わせ、弱みを補い合い、\n互いを尊敬し、互いを高め合う。",
  "そして、自分自身も変わり続ける。",
  "Change Yourself.",
  "他人を変えることから始めるのではなく、\nまず自分から変わる。",
  "その一人ひとりの変化が、\nチームを変え、会社を変え、未来を変えていく。",
  "それが、he-roの理想の姿。"
];

type Principle = {
  no: string;
  en: string;
  stanzas: string[];
};

const principles: Principle[] = [
  {
    no: "01",
    en: "Put People Where They Shine",
    stanzas: [
      `私たちは、誰が優秀かを決めるのではなく、\n誰が、どこで最も輝くのかを見つける。`,
      `人には、それぞれ異なる才能がある。\nその才能を正しく見つけ、活かせる場所をつくる。`,
      `人を仕事に合わせるのではなく、\n人と仕事が最も輝く組み合わせをつくる。`,
      `一人ひとりが力を発揮できるとき、\n組織はもっと強くなる。`,
    ],
  },
  {
    no: "02",
    en: "Grow People, Not Just Performance",
    stanzas: [
      `私たちは、今すぐ成果を出せる人だけを求めない。`,
      `人は、環境によって成長する。\nだから私たちは、即戦力を探す前に、\n人が成長できる環境をつくる。`,
      `目の前の成果だけではなく、\nその人が将来どこまで成長できるのかを見る。`,
      `人を育てることは、組織を強くすること。`,
    ],
  },
  {
    no: "03",
    en: "Different People, One Purpose",
    stanzas: [
      `私たちは、全員が同じである必要はない。`,
      `考え方も、得意なことも、経験も違っていい。`,
      `むしろ、その違いこそが組織の強さになる。`,
      `一人ではできないことも、\n異なる才能を持つ人たちが互いを補えばできる。`,
      `違いをなくすのではなく、\n違いを力に変える。`,
    ],
  },
  {
    no: "04",
    en: "People First, Value Follows",
    stanzas: [
      `お客様に最高の価値を届けたいなら、\nまず働く人が最高の状態でなければならない。`,
      `幸せに働けること。\n自分の仕事に誇りを持てること。\n成長を実感できること。`,
      `それは成果の妨げではない。`,
      `人が幸せに働ける組織だからこそ、\nお客様を幸せにできる。`,
      `人を大切にすることから、価値は生まれる。`,
    ],
  },
  {
    no: "05",
    en: "Change the Perspective",
    stanzas: [
      `問題に直面したとき、\n私たちは一つの答えに固執しない。`,
      `「できない」のではなく、\n「別のやり方ならできるのではないか」。`,
      `「向いていない」のではなく、\n「向いている場所が別にあるのではないか」。`,
      `「失敗した」のではなく、\n「別の視点から見れば何が得られたのか」。`,
      `私たちは、視点を変えることで可能性を見つける。`,
      `答えを変える前に、\n視点を変える。`,
    ],
  },
  {
    no: "06",
    en: "Build the Environment, Unlock the Potential",
    stanzas: [
      `人の能力には、環境によって引き出されるものがある。`,
      `だから私たちは、\n「もっと頑張れ」と言う前に、\n「もっと力を発揮できる環境はないか」と考える。`,
      `人を変えるのではなく、\n環境を変える。`,
      `才能を探すだけではなく、\n才能が生まれ、育ち、発揮される場所をつくる。`,
      `可能性は、人の中だけにあるのではない。\n人と環境の間にある。`,
    ],
  },
  {
    no: "07",
    en: "Orchestrate, Don't Control",
    stanzas: [
      `私たちは、人を細かく管理するのではなく、\nそれぞれが力を発揮できるように全体を設計する。`,
      `誰か一人がすべてを担う必要はない。`,
      `それぞれの得意分野を活かし、\n役割を分け、互いの能力を組み合わせる。`,
      `指揮者がすべての楽器を演奏する必要がないように、\nリーダーがすべてを決める必要もない。`,
      `人を動かすのではなく、\n人が自然と力を発揮できるオーケストレーションをつくる。`,
    ],
  },
  {
    no: "08",
    en: "Understand Before You Judge",
    stanzas: [
      `私たちは、理解することに徹する。`,
      `すぐに答えを出さなくていい。\nすぐに判断しなくていい。`,
      `時間がかかっても、\n相手の言葉を聞き、\n背景を知り、\n考えを知り、\n本質を理解する。`,
      `分からないことを、\n分かったつもりにしない。`,
      `自分の価値観だけで、\n相手や物事を決めつけない。`,
      `理解するために必要なら、\n何度でも問い、何度でも考える。`,
      `早く答えることよりも、\n正しく理解することを大切にする。`,
      `時間がかかってもいい。\nまず、理解に徹する。`,
      `理解できれば、\n見える景色が変わる。`,
      `理解できれば、\n本当に必要なことが見えてくる。`,
      `理解することは、\nすべての判断の始まりである。`,
    ],
  },
  {
    no: "09",
    en: "Continuity Creates Strength",
    stanzas: [
      `継続は力なり。`,
      `大きな変化は、\n一度の努力から生まれるものではない。`,
      `小さな一歩を積み重ねる。\n昨日より少し前へ進む。\n失敗しても、また挑戦する。`,
      `すぐに結果が出なくても、\n続けることで経験が積み重なり、\nやがて大きな力になる。`,
      `才能だけが、人を成長させるのではない。`,
      `続けることそのものが、\n新しい才能を生み出していく。`,
      `だから私たちは、\n一歩一歩を大切にする。`,
      `継続は、未来を変える力になる。`,
      `Continuity creates strength.`,
    ],
  },
  {
    no: "10",
    en: "Change Yourself",
    stanzas: [
      `私たちは、変化を恐れない。`,
      `環境が変わるのを待つのではなく、\n自ら考え、自ら選び、自ら変わる。`,
      `うまくいかないとき、\n自分を否定する必要はない。`,
      `視点を変える。\nやり方を変える。\n環境を変える。\n時には、自分自身を変える。`,
      `変わることは、過去の自分を否定することではない。`,
      `昨日の自分を超え、\nまだ見えていない可能性を見つけることだ。`,
      `誰かに変えられるのではなく、\n自分の意思で変わる。`,
    ],
  },
];

type Dont = {
  no: string;
  title: string;
  items: string[];
  note: string[];
};

const donts: Dont[] = [
  {
    no: "01",
    title: "人格を否定してはいけない",
    items: [
      "「お前はダメな人間だ」など、人そのものを否定する",
      "能力や性格を決めつける",
      "人格と仕事上の問題を混同する",
      "一度の失敗で、その人の価値を判断する",
    ],
    note: ["問題を指摘しても、人の価値を否定しない。"],
  },
  {
    no: "02",
    title: "人前で人を追い詰めてはいけない",
    items: [
      "大声で怒鳴る",
      "人前で恥をかかせる",
      "みんなの前で責め続ける",
      "失敗を見せしめにする",
    ],
    note: ["指導は、人を傷つけるためではなく、成長させるために行う。"],
  },
  {
    no: "03",
    title: "教えるときに威圧してはいけない",
    items: [
      "怒鳴ったり、大声を出したりして教える",
      "恐怖を与えて言うことを聞かせる",
      "「こんなことも分からないのか」と相手を萎縮させる",
      "質問や意見を言いにくい空気をつくる",
      "威圧することを「厳しい指導」「教育」と正当化する",
    ],
    note: [
      "教えるとは、相手を怖がらせることではない。",
      "相手が安心して質問し、理解し、成長できる環境をつくることである。",
    ],
  },
  {
    no: "04",
    title: "「できない」で人を切り捨ててはいけない",
    items: [
      "「できないからダメ」と決めつける",
      "教えずに結果だけを求める",
      "「即戦力」を理由に育成を放棄する",
      "一度できなかっただけで可能性を否定する",
    ],
    note: ["できないなら、まず「なぜできないのか」を理解する。"],
  },
  {
    no: "05",
    title: "理解せずに決めつけてはいけない",
    items: [
      "話を最後まで聞かずに判断する",
      "相手の意図を勝手に決めつける",
      "表面的な行動だけで人を評価する",
      "自分の価値観だけを正解にする",
    ],
    note: ["理解に徹する。", "理解できていないなら、判断を急がない。"],
  },
  {
    no: "06",
    title: "失敗を責めるだけにしてはいけない",
    items: [
      "「なんで失敗した？」だけで終わる",
      "失敗した人だけに責任を押しつける",
      "失敗を隠したくなる環境をつくる",
      "同じ失敗を防ぐ仕組みを考えない",
    ],
    note: ["失敗を責めるのではなく、失敗から学び、次に活かす。"],
  },
  {
    no: "07",
    title: "人を比較して優劣をつけてはいけない",
    items: [
      "「あの人のほうが優秀」と言って人を下げる",
      "全員に同じ能力を求める",
      "苦手なことだけを見て評価する",
      "一つの尺度だけで人の価値を決める",
    ],
    note: [
      "人にはそれぞれの強みがある。",
      "優劣ではなく、適材適所を考える。",
    ],
  },
  {
    no: "08",
    title: "権力を使って人を従わせてはいけない",
    items: [
      "立場の強さを利用して威圧する",
      "反論できない状況を利用する",
      "「上司だから正しい」と考える",
      "恐怖によって人を動かす",
    ],
    note: ["人を動かすのは、恐怖ではなく信頼である。"],
  },
  {
    no: "09",
    title: "意見を言えない環境をつくってはいけない",
    items: [
      "反対意見を否定する",
      "質問を馬鹿にする",
      "「そんなことも分からないのか」と言う",
      "上司の意見に従うことを「協調性」とする",
    ],
    note: ["違う意見は、組織を強くする。"],
  },
  {
    no: "10",
    title: "人の成長を他人任せにしてはいけない",
    items: [
      "「本人の努力不足」で終わらせる",
      "教育する責任を放棄する",
      "成長の機会を与えない",
      "育てる仕組みを作らない",
    ],
    note: ["人を採用するだけではなく、人が成長できる環境をつくる。"],
  },
  {
    no: "11",
    title: "合わない人を無理に変えようとしてはいけない",
    items: [
      "自分の理想の人間にしようとする",
      "個性を消そうとする",
      "強みではなく弱みに合わせて評価する",
      "「普通はこうする」と押しつける",
    ],
    note: ["変えるべきなのは、その人自身ではなく、必要な行動と環境である。"],
  },
  {
    no: "12",
    title: "人を守ることを「甘やかし」と考えてはいけない",
    items: [
      "厳しくすることを教育だと勘違いする",
      "傷つけることを「成長のため」と正当化する",
      "我慢させることを「強くすること」と考える",
      "助けを求める人を弱いと判断する",
    ],
    note: ["人を守ることと、人を甘やかすことは違う。"],
  },
  {
    no: "13",
    title: "問題を放置してはいけない",
    items: [
      "パワハラを見て見ぬふりをする",
      "「本人同士の問題」として片づける",
      "被害を受けている人に我慢させる",
      "問題が大きくなるまで何もしない",
    ],
    note: ["人を守るために、必要なときは組織が介入する。"],
  },
  {
    no: "14",
    title: "「継続は力なり」を忘れてはいけない",
    items: [
      "一度の努力で結果を求める",
      "短期的な結果だけで人を評価する",
      "成長の途中にいる人を見捨てる",
      "挑戦を続けている人を否定する",
    ],
    note: ["成長には時間がかかる。", "継続できる環境をつくる。"],
  },
  {
    no: "15",
    title: "自分だけが正しいと思ってはいけない",
    items: [
      "自分の経験を絶対視する",
      "「昔はこうだった」を正解にする",
      "若い人の意見を軽視する",
      "新しい考えを最初から否定する",
    ],
    note: ["自分自身も変わり続ける。"],
  },
];
---

<main class="app-page">
  <section class="section philosophy-hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="hero-inner reveal">
        <p class="hero-eyebrow">He-ro</p>
        <h1 class="philosophy-main-title">OUR PHILOSOPHY</h1>
        <p class="philosophy-subtitle">
          人を、最も輝く場所へ。<br />
          私たちが目指す理想の姿。<br />
          大切にしている10の考え方と、<br />
          決してやってはいけない15のこと。
        </p>
        <nav class="hero-links" aria-label="ページ内リンク">
          <a href="#vision" class="hero-link">理想の姿</a>
          <a href="#principle-01" class="hero-link">10の考え方</a>
          <a href="#donts" class="hero-link">やってはいけないこと</a>
        </nav>
        <a href="#vision" class="hero-scroll-cue" aria-label="理念を読む">
          <span>Scroll</span>
          <span class="hero-scroll-line" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section vision-section" id="vision" aria-labelledby="vision-title">
    <div class="section-content vision-content">
      <div class="vision-header">
        <p class="hero-eyebrow">Our Vision</p>
        <h2 class="vision-title" id="vision-title">he-roの理想の姿</h2>
      </div>
      <div class="vision-text">
        {visionStanzas.map((stanza) => (
          <p class:list={["stanza", { "vision-change": stanza === "Change Yourself." }]}>
            {stanza}
          </p>
        ))}
      </div>
    </div>
  </section>

  <section class="section principles-section">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <ol class="principle-list">
        {
          principles.map((principle) => (
            <li
              class="principle reveal"
              id={`principle-${principle.no}`}
              data-index={principle.no}
            >
              <div class="principle-index" aria-hidden="true">
                <span class="principle-no">{principle.no}</span>
                <span class="principle-rule" />
              </div>
              <div class="principle-body">
                <h2 class="principle-title">{principle.en}</h2>
                <div class="principle-text">
                  {principle.stanzas.map((stanza) => (
                    <p class="stanza">{stanza}</p>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section donts-section" id="donts">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="donts-header reveal">
        <p class="hero-eyebrow">Don'ts</p>
        <h2 class="donts-title">やってはいけないこと</h2>
        <p class="donts-subtitle">
          人を傷つけないために。<br />
          人の可能性を決めつけないために。<br />
          私たちが決してやらない15のこと。
        </p>
      </div>

      <ol class="dont-list">
        {
          donts.map((dont) => (
            <li class="dont reveal" id={`dont-${dont.no}`}>
              <div class="dont-head">
                <span class="dont-no" aria-hidden="true">
                  {dont.no}
                </span>
                <h3 class="dont-title">{dont.title}</h3>
              </div>
              <ul class="dont-items">
                {dont.items.map((item) => (
                  <li class="dont-item">{item}</li>
                ))}
              </ul>
              <div class="dont-note">
                {dont.note.map((line) => (
                  <p class="dont-note-line">{line}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="most-important reveal">
        <p class="hero-eyebrow">最も大切なこと</p>
        <p class="most-important-lead">人を傷つけてはいけない。</p>
        <p class="most-important-bridge">しかし、それ以上に、</p>
        <p class="most-important-lead">人の可能性を決めつけてはいけない。</p>
        <div class="most-important-text">
          <p class="stanza">
            できない人を切り捨てるのではなく、<br />
            なぜできないのかを理解する。
          </p>
          <p class="stanza">
            合わない人を否定するのではなく、<br />
            どこならその人が輝けるのかを考える。
          </p>
          <p class="stanza">
            失敗した人を責めるのではなく、<br />
            次に成功できる仕組みを考える。
          </p>
          <p class="stanza">
            教えるときは、威圧するのではなく、<br />
            相手が安心して理解できる環境をつくる。
          </p>
          <p class="stanza">
            そして、自分自身も、<br />
            「自分が正しい」と思った瞬間に、もう一度考える。
          </p>
          <p class="stanza">人を変えようとする前に、自分を変える。</p>
        </div>
        <p class="most-important-lead most-important-en">Change Your Self.</p>
        <p class="most-important-outro">
          人が輝けば、組織が輝く。<br />
          組織が輝けば、お客様も輝く。
        </p>
      </div>
    </div>
  </section>

  <section class="section closing-section">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="section-content">
      <div class="closing-card reveal">
        <p class="closing-lead">Change Yourself.</p>
        <div class="closing-text">
          <p class="stanza">自分を変えれば、<br />見える世界が変わる。</p>
